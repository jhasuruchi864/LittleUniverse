# =====================================================
# OUR LITTLE UNIVERSE 💗 - SUPABASE AUTH CONFIGURATION
# =====================================================
# Instructions:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and anon / public key below
# 4. Copy this file to .env:  cp .env.example .env
#
# IMPORTANT: NEVER commit your secret admin or private keys to GitHub!
# Only the public anon key is used for client-side authentication.
# =====================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# =====================================================
# AI COUPLE PHOTO STUDIO PROVIDER CONFIGURATION
# (Keep all API keys secret on the server - never in browser code!)
# Configure one or more providers to enable live generation:
# =====================================================
# OpenAI (DALL-E 3)
OPENAI_API_KEY=

# Stability AI
# STABILITY_API_KEY=

# Google Gemini (Imagen)
# GEMINI_API_KEY=

# =====================================================
# AI RELATIONSHIP ANALYZER CONFIGURATION
# (Used securely on backend for conversational nuance insights.
# If omitted, high-precision deterministic algorithmic analytics run automatically!)
# =====================================================
# Google Gemini (Gemini 1.5 Flash - Recommended for fast romantic reasoning)
GEMINI_API_KEY=

# OpenAI (gpt-4o-mini alternative)
# OPENAI_API_KEY=
